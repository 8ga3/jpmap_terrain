{
  "name": "jpmap-terrain",
  "version": "0.3.1",
  "description": "Terrain creation from elevation tiles of the Geospatial Information Authority of Japan.",
  "keywords": [
    "Babylon.js",
    "vite",
    "typescript",
    "es6",
    "terrain",
    "geospatial",
    "elevation"
  ],
  "homepage": "https://github.com/8ga3/jpmap_terrain",
  "bugs": {
    "url": "https://github.com/8ga3/jpmap_terrain/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8ga3/jpmap_terrain.git"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "8ga3",
    "url": "https://github.com/8ga3"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "start:test": "vite --config vite.tests.config.ts",
    "build:dev": "npm run typecheck && cross-env VITE_SOURCEMAP=true vite build --mode development",
    "build:lib": "tsdown",
    "clean:lib": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean:lib && npm run build:lib",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "npx eslint . --ext .ts,.tsx && npm run check:no-issue-refs && npm run check:tool-versions && npm run check:agent-docs",
    "check:no-issue-refs": "node scripts/checkNoIssueRefs.mjs",
    "check:agent-docs": "node scripts/checkAgentDocs.mjs",
    "check:tool-versions": "node scripts/checkToolVersions.mjs",
    "typecheck": "tsc --noEmit",
    "test:visuals": "npx playwright test",
    "test:visuals:update": "npx playwright test --update-snapshots=all",
    "test:unit": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "package-lock.json": "node scripts/checkToolVersions.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@babylonjs/core": "^9.20.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/loaders": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@babylonjs/loaders": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
