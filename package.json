{
  "name": "jpmap-terrain",
  "version": "0.1.0",
  "description": "Terrain creation from elevation tiles of the Geospatial Information Authority of Japan.",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/loaders": "^9.0.0",
    "@babylonjs/materials": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@babylonjs/loaders": {
      "optional": true
    },
    "@babylonjs/materials": {
      "optional": true
    }
  },
  "dependencies": {
    "ammo.js": "github:kripken/ammo.js",
    "recast-detour": "^1.6.4"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.9.1",
    "@babylonjs/gui-editor": "^9.9.1",
    "@babylonjs/havok": "^1.3.12",
    "@babylonjs/inspector": "^9.9.1",
    "@babylonjs/loaders": "^9.9.1",
    "@babylonjs/materials": "^9.9.1",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.5",
    "source-map-loader": "^5.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.7",
    "ts-shader-loader": "^2.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.107.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4",
    "webpack-merge": "^6.0.1"
  },
  "scripts": {
    "start": "npx webpack serve --config webpack.dev.js",
    "start:test": "npx webpack serve --config webpack.tests.js",
    "build:dev": "npm run typecheck && npx webpack --config webpack.dev.js",
    "build:lib": "tsup",
    "clean:lib": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run typecheck && npx webpack --config webpack.prod.js",
    "lint": "npx eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:visuals": "npx playwright test",
    "test:visuals:update": "npx playwright test --update-snapshots=all",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8ga3/jpmap_terrain.git"
  },
  "keywords": [
    "Babylon.js",
    "webpack",
    "typescript",
    "es6",
    "terrain",
    "geospatial",
    "elevation"
  ],
  "author": {
    "name": "8ga3",
    "email": "masarue@gmail.com",
    "url": "https://github.com/8ga3"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/8ga3/jpmap_terrain/issues"
  },
  "homepage": "https://github.com/8ga3/jpmap_terrain"
}
