{
  "name": "jpmap-terrain",
  "version": "0.1.0",
  "description": "Terrain creation from elevation tiles of the Geospatial Information Authority of Japan.",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/loaders": "^9.0.0",
    "@babylonjs/materials": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@babylonjs/loaders": {
      "optional": true
    },
    "@babylonjs/materials": {
      "optional": true
    }
  },
  "dependencies": {
    "ammo.js": "github:kripken/ammo.js",
    "recast-detour": "^1.6.4"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.11.0",
    "@babylonjs/gui-editor": "^9.11.0",
    "@babylonjs/havok": "^1.3.12",
    "@babylonjs/inspector": "^9.11.0",
    "@babylonjs/loaders": "^9.11.0",
    "@babylonjs/materials": "^9.11.0",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.59",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.7",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "scripts": {
    "start": "vite",
    "start:test": "vite --config vite.tests.config.ts",
    "build:dev": "npm run typecheck && vite build --mode development",
    "build:lib": "tsup",
    "clean:lib": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run typecheck && vite build",
    "lint": "npx eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:visuals": "npx playwright test",
    "test:visuals:update": "npx playwright test --update-snapshots=all",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8ga3/jpmap_terrain.git"
  },
  "keywords": [
    "Babylon.js",
    "vite",
    "typescript",
    "es6",
    "terrain",
    "geospatial",
    "elevation"
  ],
  "author": {
    "name": "8ga3",
    "email": "masarue@gmail.com",
    "url": "https://github.com/8ga3"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/8ga3/jpmap_terrain/issues"
  },
  "homepage": "https://github.com/8ga3/jpmap_terrain"
}
