{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "emitDeclarationOnly": false,
        "rootDir": "./src",
        "outDir": "./dist",
        "types": [],
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/lib.ts", "src/**/*.ts"],
    "exclude": [
        "node_modules",
        "dist",
        "tests/**",
        "**/*.spec.ts",
        "playwright.config.ts",
        "webpack.*.js"
    ]
}
